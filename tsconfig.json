{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noEmit": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "types": ["vite/client", "node"],
        "paths": {
            "@domain/*": ["./src/domain/*"],
            "@pages/*": ["./src/pages/*"],
            "@test/*": ["./src/test/*"]
        }
    },
    "include": ["src", "dev", "vite.config.ts"]
}
