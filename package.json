{
    "name": "frontend-template",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": "~22"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "setup": "playwright install chromium",
        "test": "vitest run --passWithNoTests",
        "lint:oxlint": "oxlint --type-aware --deny-warnings",
        "lint:eslint": "eslint . --max-warnings 0 --cache --cache-strategy content",
        "lint:tsc": "tsc --noEmit",
        "lint:fix": "npm run lint:oxlint -- --fix && npm run lint:eslint -- --fix",
        "validate:fast": "npm run lint:oxlint && npm run lint:eslint && npm run lint:tsc && npm run lint:structure",
        "validate": "npm run validate:fast && npm run test:scripts && npm test && npm run build",
        "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
        "lint:structure": "node scripts/check-structure.mjs",
        "test:scripts": "node --test \"scripts/**/*.test.mjs\""
    },
    "dependencies": {
        "@tanstack/react-query": "^5.107.1",
        "antd": "^6.7.0",
        "dayjs": "^1.11.23",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.1"
    },
    "devDependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
        "@stylistic/eslint-plugin": "^6.0.0",
        "@tanstack/eslint-plugin-query": "^5.107.1",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/browser-playwright": "^5.1.0",
        "eslint": "^10.15.0",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "happy-dom": "^21.0.4",
        "oxlint": "^1.93.0",
        "oxlint-tsgolint": "^7.0.2007",
        "playwright": "^1.65.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0",
        "vitest-browser-react": "^2.3.0"
    }
}
